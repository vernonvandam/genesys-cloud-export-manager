/* Decorative background for the authentication/login screens.
   Keep this near the end of App.scss so it overrides only the
   background-related properties on the existing .auth-page rule. */
.auth-page {
  background-image: url('/background.svg');
  background-repeat: no-repeat;
  background-position: right bottom;
  background-size: min(54vw, 680px) auto;
}

@media (max-width: 640px) {
  .auth-page {
    background-size: min(82vw, 420px) auto;
  }
}
